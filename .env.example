# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# Domain(s) the site is served on, comma separated
DJANGO_ALLOWED_HOSTS=quest.example.com,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://quest.example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=

# --- Postgres ---
POSTGRES_DB=physquest
POSTGRES_USER=physquest
POSTGRES_PASSWORD=change-me

# --- Runtime ---
UVICORN_WORKERS=2
# DB connections per worker (Postgres allows 100 in total)
DB_POOL_MAX=20
# Port on the host (127.0.0.1) that the external nginx proxies to
WEB_PORT=8080

# --- Dev only ---
# 1 = serve Vite over https with a self-signed cert (camera on phones in LAN)
DEV_HTTPS=0
